import math

x = float(input("Введіть значення аргументу x: "))

if x > 12.1:
    f = math.log(abs(x - 1)) + math.log10(abs(x ** (0.7 * x) + 2))
elif -5.7 <= x <= 12.1:
    f = math.e * 4 * x**7 + 2 - (abs(x) ** (1/3)) * (1 if x >= 0 else -1)
else:  # x < -5.7
    f = 4.27 * x + 4.33 * x**2 + math.sin(x + 1)

print(f"f({x}) = {f:.6f}")
