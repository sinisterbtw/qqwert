a = float(input("Введіть a (брусок): "))
b = float(input("Введіть b (брусок): "))
c = float(input("Введіть c (брусок): "))

m = float(input("Введіть m (отвір): "))
n = float(input("Введіть n (отвір): "))

# сортуємо розміри бруска за зростанням
brick = sorted([a, b, c])
# для проходження крізь отвір беремо два найменші виміри бруска —
# це переріз, яким брусок просувається крізь отвір
side1, side2 = brick[0], brick[1]

# сортуємо розміри отвору
hole = sorted([m, n])
h1, h2 = hole[0], hole[1]

if side1 <= h1 and side2 <= h2:
    print("Брусок пройде крізь отвір")
else:
    print("Брусок НЕ пройде крізь отвір")
